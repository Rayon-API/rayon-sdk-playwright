{
  "name": "rayon-sdk-playwright",
  "version": "1.0.0",
  "description": "Optional Playwright material collector for the Rayon Node SDK",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "RELEASE.md",
    "docs/reference.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "rayon-sdk-js": "^2.0.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0 <2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "playwright-core": "1.61.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rayon-API/rayon-sdk-playwright.git"
  },
  "homepage": "https://github.com/Rayon-API/rayon-sdk-playwright#readme",
  "bugs": {
    "url": "https://github.com/Rayon-API/rayon-sdk-playwright/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
